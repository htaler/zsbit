---
// PROTOTYP: Wariant C „Bento”. Wszystkie główne akcje jako kafle nad linią zgięcia,
// ściana prelegentów i archiwum jako siatka plakatów.
import type { Edition } from '../../lib/editions';
import { fmtDate } from '../../lib/editions';
interface Props { editions: Edition[]; latest: Edition; stats: { editions: number; talks: number; speakers: number; since: number }; nextBinary: string }
const { editions, latest, stats, nextBinary } = Astro.props;
const time = latest.date.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Warsaw' });

// Ściana prelegentów: każdy prelegent raz, z liczbą wystąpień.
const speakerCount = new Map<string, number>();
for (const e of editions) for (const t of e.talks) {
  if (t.kind === 'panel') continue;
  for (const s of t.speaker.split(', ')) speakerCount.set(s, (speakerCount.get(s) ?? 0) + 1);
}
const speakers = [...speakerCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'pl'));
const sponsorsAll = [...new Set(editions.flatMap((e) => [...e.sponsors, ...e.partners]))];
---

<div class="c">
  <header class="top">
    <img src="/img/logo.svg" alt="ZS BIT" width="60" height="41" class="logo" />
    <span class="tag">Spotkania branży IT · Szczecin</span>
    <nav><a href="#c-prelegenci">Prelegenci</a><a href="#c-archiwum">Archiwum</a><a href="#c-partnerzy">Partnerzy</a></nav>
  </header>

  <section class="bento">
    <article class="tile t-event">
      <div class="only-upcoming">
        <p class="eyebrow">Najbliższa edycja · <span class="mono">{latest.binary}</span></p>
        <h1>{latest.name}</h1>
        <p class="when">{fmtDate(latest.date)}, {time}<br />{latest.venue?.name}</p>
        <a class="btn btn-light" href={latest.registrationUrl}>Zarezerwuj miejsce →</a>
        <p class="seats">wolne miejsca: <b>37</b> <span class="demo-tag">dane przykładowe</span></p>
      </div>
      <div class="only-between">
        <p class="eyebrow">Następna edycja · <span class="mono">{nextBinary}</span></p>
        <h1 class="smaller">Data<br />wkrótce.</h1>
        <p class="when">Ostatnio: {latest.name}, {fmtDate(latest.date)}</p>
        <a class="btn btn-light" href="#c-nl">Powiadom mnie →</a>
      </div>
    </article>

    <article class="tile t-cfp">
      <p class="eyebrow">Call for papers</p>
      <h2>Wystąp na ZS BIT</h2>
      <p>Prelekcja albo lightning talk. Temat techniczny lub zupełnie nie.</p>
      <details class="cfp-details">
        <summary class="btn btn-dark">Zgłoś temat</summary>
        <form class="cfp-form">
          <input required placeholder="Imię i nazwisko" aria-label="Imię i nazwisko" />
          <input type="email" required placeholder="E-mail" aria-label="E-mail" />
          <input required placeholder="Tytuł wystąpienia" aria-label="Tytuł" />
          <select aria-label="Format"><option>Prelekcja</option><option>Lightning talk</option></select>
          <textarea rows="3" required placeholder="O czym opowiesz?" aria-label="Abstrakt"></textarea>
          <label class="consent"><input type="checkbox" required /> Zgoda na przetwarzanie danych w celu oceny zgłoszenia</label>
          <button class="btn btn-dark" type="submit">Wyślij</button>
        </form>
      </details>
    </article>

    <article class="tile t-stats">
      <div><b>{stats.editions}</b><span>edycji</span></div>
      <div><b>{stats.talks}</b><span>wystąpień</span></div>
      <div><b>{stats.speakers}</b><span>prelegentów</span></div>
    </article>

    <article class="tile t-photo">
      <img src="/img/gallery/7.jpeg" alt="Uczestnicy ZS BIT podczas prelekcji" />
      <span class="cap">Tak to wygląda na żywo</span>
    </article>

    <article class="tile t-nl" id="c-nl">
      <p class="eyebrow">Newsletter</p>
      <h2>Daty i program jako pierwszy</h2>
      <form class="nl">
        <input type="email" required placeholder="twoj@email.pl" aria-label="E-mail" />
        <button class="btn btn-dark" type="submit">Zapisz</button>
        <label class="consent"><input type="checkbox" required /> Zgoda na newsletter ZS BIT</label>
      </form>
    </article>

    <article class="tile t-rules">
      <ul>
        <li><span>✓</span> bezpłatnie</li>
        <li><span>✕</span> rekrutacja</li>
        <li><span>✕</span> gry na telefonach</li>
        <li><span>✓</span> Q&amp;A i networking</li>
      </ul>
    </article>

    <article class="tile t-support">
      <p class="eyebrow">Wesprzyj</p>
      <a href="https://suppi.pl/zsbit">Kawa na Suppi ↗</a>
      <a href="mailto:zsbit.kontakt@gmail.com">Oferta sponsorska ↗</a>
    </article>
  </section>

  <section class="speakers" id="c-prelegenci">
    <h2 class="sec">Kto już u nas wystąpił</h2>
    <p class="speaker-wall">
      {speakers.map(([name, n]) => <span class={n > 1 ? 'multi' : ''}>{name}{n > 1 && <sup>×{n}</sup>}</span>)}
      <a href="#" class="you">Ty?</a>
    </p>
  </section>

  <section class="posters" id="c-archiwum">
    <h2 class="sec">Archiwum</h2>
    <div class="poster-grid">
      {editions.map((e) => (
        <details class="poster">
          <summary>
            <img src={e.banner} alt="" loading="lazy" />
            <span class="p-meta"><span class="mono">{e.binary}</span> {e.name}<small>{fmtDate(e.date)}</small></span>
          </summary>
          <ul>
            {e.talks.map((t) => <li><b>{t.speaker}</b>: {t.title}{t.kind === 'lightning' && <em> · lightning</em>}</li>)}
            {e.talks.length === 0 && <li>{e.note}</li>}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <section class="partners" id="c-partnerzy">
    <h2 class="sec">Wspierali nas</h2>
    <ul>{sponsorsAll.map((s) => <li>{s}</li>)}</ul>
  </section>

  <footer class="foot">
    <span>© ZS BIT</span>
    <a href="https://www.facebook.com/ZSBIT/">Facebook</a>
    <a href="https://pl.linkedin.com/company/zsbit">LinkedIn</a>
    <a href="mailto:zsbit.kontakt@gmail.com">zsbit.kontakt@gmail.com</a>
    <a href="#">Polityka prywatności</a>
  </footer>
</div>

<style>
  .c {
    --bg: #f6f5ff; --ink: #14112b; --violet: #4911ff; --pink: #ff3cbc; --cyan: #7ff0f0; --lime: #d6ff5c; --card: #fff;
    background: var(--bg); color: var(--ink); font: 400 16px/1.55 'Manrope', system-ui, sans-serif; padding: 16px clamp(12px, 2.4vw, 32px) 96px; min-height: 100vh;
  }
  .c a { color: inherit; }
  h1, h2, .sec { font-family: 'Unbounded', sans-serif; letter-spacing: -0.03em; line-height: 0.98; margin: 0; }
  .mono { font-family: 'JetBrains Mono', monospace; }
  .top { display: flex; align-items: center; gap: 16px; padding: 8px 4px 20px; }
  .logo { background: var(--ink); border-radius: 12px; padding: 6px 8px; width: 64px; height: auto; }
  .tag { font-weight: 700; }
  .top nav { margin-left: auto; display: flex; gap: 20px; font-weight: 500; }
  .top nav a { text-decoration: none; }
  .bento { display: grid; gap: 12px; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(150px, auto);
    grid-template-areas: 'ev ev cfp photo' 'ev ev stats photo' 'nl nl rules sup'; }
  .tile { border-radius: 28px; padding: 24px; background: var(--card); position: relative; overflow: hidden; }
  .eyebrow { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin: 0 0 10px; opacity: .75; }
  .t-event { grid-area: ev; background: var(--violet); color: #fff; padding: clamp(24px, 3vw, 40px); display: flex; flex-direction: column; justify-content: flex-end; min-height: 440px;
    background-image: radial-gradient(circle at 85% 15%, #ff3cbc 0 18%, transparent 18.5%), radial-gradient(circle at 100% 0%, #7ff0f0 0 30%, transparent 30.5%); }
  .t-event h1 { font-size: clamp(56px, 8vw, 120px); font-weight: 900; margin-bottom: 18px; }
  .t-event h1.smaller { font-size: clamp(48px, 6vw, 88px); }
  .when { font-size: 20px; font-weight: 500; margin: 0 0 22px; }
  .seats { margin: 14px 0 0; font-size: 14px; opacity: .85; }
  .btn { display: inline-block; font: 700 16px 'Manrope', sans-serif; padding: 14px 22px; border-radius: 999px; text-decoration: none; border: 0; cursor: pointer; list-style: none; }
  .btn-light { background: var(--lime); color: var(--ink) !important; }
  .btn-dark { background: var(--ink); color: #fff !important; }
  .btn:hover { transform: translateY(-1px); }
  .t-cfp { grid-area: cfp; background: var(--pink); color: var(--ink); }
  .t-cfp h2 { font-size: 26px; margin-bottom: 8px; }
  .t-cfp p { margin: 0 0 14px; }
  .cfp-details summary::-webkit-details-marker { display: none; }
  .cfp-details[open] summary { display: none; }
  .cfp-form, .nl { display: grid; gap: 8px; }
  .cfp-form input:not([type=checkbox]), .cfp-form select, .cfp-form textarea, .nl input[type=email] { font: inherit; padding: 10px 14px; border-radius: 14px; border: 2px solid var(--ink); background: #fff; color: var(--ink); }
  .consent { font-size: 12px; display: flex; gap: 8px; align-items: flex-start; }
  .t-stats { grid-area: stats; display: grid; grid-template-columns: repeat(3, 1fr); align-items: end; background: var(--ink); color: #fff; }
  .t-stats b { display: block; font: 900 clamp(28px, 3vw, 44px)/1 'Unbounded', sans-serif; color: var(--cyan); }
  .t-stats span { font-size: 13px; opacity: .7; }
  .t-photo { grid-area: photo; padding: 0; }
  .t-photo img { width: 100%; height: 100%; object-fit: cover; }
  .cap { position: absolute; left: 14px; bottom: 14px; background: #fff; border-radius: 999px; padding: 6px 12px; font-size: 13px; font-weight: 700; }
  .t-nl { grid-area: nl; background: var(--cyan); display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px 24px; align-items: center; }
  .t-nl .eyebrow { grid-column: 1 / -1; margin: 0; }
  .t-nl h2 { font-size: clamp(22px, 2.2vw, 30px); }
  .nl { grid-template-columns: 1fr auto; }
  .nl .consent { grid-column: 1 / -1; }
  .t-rules { grid-area: rules; background: var(--lime); }
  .t-rules ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-weight: 700; font-size: 17px; }
  .t-rules li span { display: inline-block; width: 22px; }
  .t-support { grid-area: sup; display: flex; flex-direction: column; gap: 8px; }
  .t-support a { font: 700 18px 'Manrope', sans-serif; text-decoration: none; border-bottom: 2px solid var(--ink); align-self: flex-start; }
  section:not(.bento) { margin-top: 72px; }
  .sec { font-size: clamp(28px, 4vw, 48px); margin-bottom: 24px; }
  .speaker-wall { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .speaker-wall span, .speaker-wall .you { padding: 8px 16px; border-radius: 999px; background: #fff; border: 1.5px solid #14112b1f; font-weight: 500; }
  .speaker-wall .multi { background: var(--ink); color: #fff; }
  .speaker-wall sup { color: var(--cyan); margin-left: 4px; font-weight: 700; }
  .speaker-wall .you { background: var(--pink); text-decoration: none; font-weight: 700; border-color: transparent; }
  .poster-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; align-items: start; }
  .poster { background: #fff; border-radius: 20px; overflow: hidden; }
  .poster summary { list-style: none; cursor: pointer; }
  .poster summary::-webkit-details-marker { display: none; }
  .poster img { aspect-ratio: 2 / 1; width: 100%; object-fit: cover; }
  .p-meta { display: block; padding: 12px 16px 14px; font-weight: 700; }
  .p-meta .mono { color: var(--violet); margin-right: 6px; }
  .p-meta small { display: block; font-weight: 400; opacity: .65; }
  .poster ul { margin: 0; padding: 0 16px 16px 32px; font-size: 14px; display: grid; gap: 6px; }
  .poster[open] { grid-row: span 2; outline: 2px solid var(--violet); }
  .partners ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; font: 700 clamp(18px, 2vw, 26px) 'Unbounded', sans-serif; color: #14112b8c; }
  .foot { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 72px; padding-top: 24px; border-top: 1.5px solid #14112b1f; font-size: 14px; }
  @media (max-width: 1000px) {
    .bento { grid-template-columns: 1fr 1fr; grid-template-areas: 'ev ev' 'cfp photo' 'stats stats' 'nl nl' 'rules sup'; }
  }
  @media (max-width: 620px) {
    .bento { grid-template-columns: 1fr; grid-template-areas: 'ev' 'cfp' 'nl' 'stats' 'photo' 'rules' 'sup'; }
    .t-event { min-height: 380px; }
    .t-photo { min-height: 220px; }
    .t-nl { grid-template-columns: 1fr; }
    .tag, .top nav { display: none; }
  }
</style>
