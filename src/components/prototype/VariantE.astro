---
// PROTOTYP: Wariant E „8-bit”. Retro gra: pasek statystyk, edycje jako „wybór poziomu”,
// CFP jako „dołącz do drużyny”, wsparcie jako „wrzuć monetę”. Oryginalna estetyka pikselowa,
// bez nawiązań do konkretnej gry.
import type { Edition } from '../../lib/editions';
import { fmtShort } from '../../lib/editions';
interface Props { editions: Edition[]; latest: Edition; stats: { editions: number; talks: number; speakers: number; since: number }; nextBinary: string }
const { editions, latest, stats, nextBinary } = Astro.props;
const time = latest.date.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Warsaw' });

// „Hi-score”: prelegent z największą liczbą wystąpień (fakt z danych, nie ozdobnik).
const count = new Map<string, number>();
for (const e of editions) for (const t of e.talks) {
  if (t.kind === 'panel') continue;
  for (const s of t.speaker.split(', ')) count.set(s, (count.get(s) ?? 0) + 1);
}
const [hiName, hiScore] = [...count.entries()].sort((a, b) => b[1] - a[1])[0];
const levels = [...editions].reverse();
---

<div class="e">
  <div class="scan" aria-hidden="true"></div>
  <header class="hud">
    <img src="/img/logo.svg" alt="ZS BIT" width="56" height="38" />
    <dl>
      <div><dt>Poziomy</dt><dd>{String(stats.editions).padStart(2, '0')}</dd></div>
      <div><dt>Wystąpienia</dt><dd>{String(stats.talks).padStart(3, '0')}</dd></div>
      <div><dt>Gracze</dt><dd>{String(stats.speakers).padStart(3, '0')}</dd></div>
      <div class="hi"><dt>Hi-score</dt><dd>{hiName} ×{hiScore}</dd></div>
    </dl>
  </header>

  <section class="title">
    <div class="only-upcoming">
      <p class="world">Świat Szczecin · Poziom <span>{latest.binary}</span></p>
      <h1>{latest.name}</h1>
      <p class="info">{fmtShort(latest.date)} · {time} · {latest.venue?.name}</p>
      <a class="btn start" href={latest.registrationUrl}>▶ Start: zarezerwuj miejsce</a>
      <p class="slots">
        Sloty: <span class="hearts">{Array.from({ length: 10 }, (_, i) => <i class={i < 7 ? 'full' : ''}></i>)}</span> 37/120 wolnych <span class="demo-tag">dane przykładowe</span>
      </p>
    </div>
    <div class="only-between">
      <p class="world">Świat Szczecin · Poziom <span>{nextBinary}</span></p>
      <h1 class="loading">Ładowanie<span class="dots">...</span></h1>
      <div class="progress" role="img" aria-label="Następna edycja w przygotowaniu"><span></span></div>
      <p class="info">Następny poziom wkrótce. Zapisz grę, a damy znać o dacie.</p>
      <a class="btn start" href="#e-save">▶ Zapisz grę</a>
      <a class="btn alt" href="#e-team">+ Dołącz do drużyny</a>
    </div>
  </section>

  <section class="rules">
    <h2>Zasady gry</h2>
    <ul>
      <li><b>Free to play</b><span>Wstęp bezpłatny. Rejestracja, bo miejsc jest ograniczona liczba.</span></li>
      <li><b>Bez rekruterów</b><span>Żadnych bossów z ofertą pracy. Przychodzisz po wiedzę i ludzi.</span></li>
      <li><b>Bez telefonów</b><span>Żadnych quizów w aplikacjach. Prelekcje, Q&amp;A, rozmowy.</span></li>
    </ul>
  </section>

  <section class="levels">
    <h2>Wybierz poziom</h2>
    <div class="grid">
      {levels.map((e) => (
        <details class="lvl">
          <summary>
            <span class="lbin">{e.binary}</span>
            <span class="lname">{e.name}</span>
            <span class="ldate">{fmtShort(e.date)}</span>
            <span class="stars">{'★'.repeat(Math.min(e.talks.length, 8))}</span>
          </summary>
          <div class="panel">
            <p class="ptitle">Poziom {e.binary}: {e.name}</p>
            <ul>{e.talks.map((t) => <li><b>{t.speaker}</b> · {t.title}{t.kind === 'lightning' && <em> [lightning]</em>}</li>)}</ul>
            {e.hosts.length > 0 && <p class="pmeta">Mistrzowie gry: {e.hosts.join(', ')}</p>}
          </div>
        </details>
      ))}
      <div class="lvl locked"><span class="lbin">{nextBinary}</span><span class="lname">🔒 wkrótce</span></div>
    </div>
  </section>

  <section class="team" id="e-team">
    <h2>Dołącz do drużyny</h2>
    <p class="sub">Stwórz postać prelegenta. Doświadczenie sceniczne nie jest wymagane.</p>
    <form class="char">
      <label>Imię gracza<input required /></label>
      <label>E-mail<input type="email" required /></label>
      <fieldset>
        <legend>Klasa</legend>
        <label class="cls"><input type="radio" name="e-cls" checked /><span><b>Prelekcja</b>pełne wystąpienie + Q&amp;A</span></label>
        <label class="cls"><input type="radio" name="e-cls" /><span><b>Lightning</b>krótko i na jeden temat</span></label>
      </fieldset>
      <label class="wide">Nazwa questa (tytuł)<input required /></label>
      <label class="wide">Opis questa<textarea rows="4" required></textarea></label>
      <label class="consent wide"><input type="checkbox" required /> Zgoda na przetwarzanie danych w celu oceny zgłoszenia</label>
      <button class="btn start" type="submit">▶ Wyślij zgłoszenie</button>
    </form>
  </section>

  <section class="bottom">
    <form class="save" id="e-save">
      <h2>Zapisz grę</h2>
      <p class="sub">Newsletter: daty i program jako pierwszy.</p>
      <div class="row"><input type="email" required placeholder="twoj@email.pl" aria-label="E-mail" /><button class="btn" type="submit">OK</button></div>
      <label class="consent"><input type="checkbox" required /> Zgoda na newsletter ZS BIT</label>
    </form>
    <div class="coin">
      <h2>Wrzuć monetę</h2>
      <p class="sub">Wesprzyj kolejne poziomy.</p>
      <a class="btn" href="https://suppi.pl/zsbit">◎ Kawa na Suppi</a>
      <a class="btn alt" href="mailto:zsbit.kontakt@gmail.com">Sponsoring</a>
    </div>
  </section>

  <footer class="foot">
    <span>© ZS BIT · Szczecin</span>
    <a href="https://www.facebook.com/ZSBIT/">Facebook</a>
    <a href="https://pl.linkedin.com/company/zsbit">LinkedIn</a>
    <a href="#">Polityka prywatności</a>
    <span class="press">Naciśnij ← → aby zmienić wariant</span>
  </footer>
</div>

<style>
  .e {
    --bg: #0e0b24; --bg2: #19143d; --ink: #f1eeff; --mute: #9b94d4; --cyan: #00d4d4; --pink: #ff3cbc; --violet: #6b30ff; --yellow: #ffd400; --green: #3be38a;
    position: relative; background: var(--bg); color: var(--ink); font: 400 16px/1.6 'IBM Plex Mono', ui-monospace, monospace; min-height: 100vh; overflow-x: clip;
    --px: 4px;
  }
  .e a { color: inherit; }
  h1, h2, .world, .btn, dt, .lbin, .lname, .ptitle { font-family: 'Tiny5', 'IBM Plex Mono', monospace; }
  .scan { pointer-events: none; position: absolute; inset: 0; z-index: 3; background: repeating-linear-gradient(0deg, #0000 0 3px, #00000030 3px 4px); }
  .hud { position: sticky; top: 0; z-index: 4; display: flex; align-items: center; gap: 24px; padding: 10px clamp(16px, 3vw, 40px); background: #000; border-bottom: var(--px) solid var(--violet); }
  .hud dl { display: flex; flex-wrap: wrap; gap: 4px 32px; margin: 0 0 0 auto; }
  .hud div { display: flex; gap: 10px; align-items: baseline; }
  .hud dt { font-size: 13px; color: var(--mute); text-transform: uppercase; }
  .hud dd { margin: 0; font: 700 18px 'Tiny5', monospace; color: var(--yellow); }
  .hud .hi dd { color: var(--pink); }
  section { position: relative; z-index: 1; padding: 72px clamp(16px, 3vw, 40px); }
  .title { min-height: 78svh; display: grid; align-content: center; justify-items: center; text-align: center; background:
      radial-gradient(circle at 50% 120%, #6b30ff55, transparent 60%),
      linear-gradient(#0e0b24, #0e0b24 60%, #19143d); }
  .title::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 64px; background:
      linear-gradient(90deg, var(--violet) 50%, #4a1fd1 50%) 0 0 / 32px 16px, linear-gradient(90deg, #4a1fd1 50%, var(--violet) 50%) 0 16px / 32px 16px; }
  .world { text-transform: uppercase; letter-spacing: 0.1em; color: var(--mute); margin: 0 0 12px; }
  .world span { color: var(--cyan); }
  .title h1 { margin: 0; text-transform: uppercase; font-size: clamp(52px, 14vw, 180px); line-height: 0.95; color: var(--ink); text-shadow: 6px 6px 0 var(--pink), 12px 12px 0 var(--violet); }
  .title h1.loading { font-size: clamp(34px, 9vw, 112px); }
  .dots { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .info { font-size: 18px; margin: 24px 0 28px; }
  .btn { display: inline-block; font-size: 18px; text-transform: uppercase; text-decoration: none; padding: 14px 22px; margin: 4px 8px; background: var(--yellow); color: #120d2e !important; border: 0; cursor: pointer;
    box-shadow: 0 -4px 0 0 #000, 0 4px 0 0 #000, -4px 0 0 0 #000, 4px 0 0 0 #000, inset -4px -4px 0 0 #c9a600; }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(2px); box-shadow: 0 -4px 0 0 #000, 0 4px 0 0 #000, -4px 0 0 0 #000, 4px 0 0 0 #000, inset 4px 4px 0 0 #c9a600; }
  .btn.alt { background: var(--cyan); box-shadow: 0 -4px 0 0 #000, 0 4px 0 0 #000, -4px 0 0 0 #000, 4px 0 0 0 #000, inset -4px -4px 0 0 #009b9b; }
  .start { animation: pulse 1.6s steps(2) infinite; }
  @keyframes pulse { 50% { filter: brightness(1.15); } }
  .slots { margin-top: 24px; color: var(--mute); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; }
  .hearts { display: inline-flex; gap: 4px; }
  .hearts i { width: 14px; height: 14px; background: #ffffff22; }
  .hearts i.full { background: var(--pink); }
  .progress { width: min(420px, 80vw); height: 28px; margin: 28px auto 0; padding: 4px; background: #000; box-shadow: 0 0 0 4px var(--ink); }
  .progress span { display: block; height: 100%; width: 40%; background: repeating-linear-gradient(90deg, var(--green) 0 16px, #000 16px 20px); animation: load 4s steps(10) infinite; }
  @keyframes load { from { width: 10%; } to { width: 90%; } }
  h2 { font-size: clamp(32px, 4.5vw, 56px); margin: 0 0 32px; color: var(--cyan); text-transform: uppercase; }
  .rules { background: var(--bg2); }
  .rules ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .rules li { padding: 24px; background: #000; box-shadow: 0 0 0 4px var(--violet); }
  .rules b { display: block; font: 700 24px 'Tiny5', monospace; color: var(--yellow); margin-bottom: 8px; }
  .rules span { color: var(--mute); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 20px; }
  .lvl { background: var(--bg2); box-shadow: 0 0 0 4px #2d2566; }
  .lvl summary { list-style: none; cursor: pointer; padding: 18px 16px; display: grid; gap: 4px; min-height: 150px; align-content: end; }
  .lvl summary::-webkit-details-marker { display: none; }
  .lvl:hover, .lvl[open] { box-shadow: 0 0 0 4px var(--yellow); }
  .lbin { font-size: 30px; color: var(--cyan); line-height: 1; }
  .lname { font-size: 20px; }
  .ldate { font-size: 12px; color: var(--mute); }
  .stars { color: var(--yellow); font-size: 12px; letter-spacing: 2px; min-height: 1em; }
  .lvl[open] { grid-column: 1 / -1; }
  .lvl[open] summary { min-height: 0; }
  .panel { padding: 0 20px 20px; border-top: 4px dashed #2d2566; }
  .ptitle { color: var(--yellow); font-size: 20px; margin: 16px 0 10px; }
  .panel ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .panel em { color: var(--pink); font-style: normal; }
  .pmeta { color: var(--mute); font-size: 13px; margin: 12px 0 0; }
  .locked { display: grid; align-content: end; gap: 4px; padding: 18px 16px; min-height: 150px; opacity: 0.55; box-shadow: 0 0 0 4px #2d2566; background: repeating-linear-gradient(45deg, #19143d 0 10px, #120e30 10px 20px); }
  .team { background: var(--bg2); }
  .sub { color: var(--mute); margin: -20px 0 28px; }
  .char { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 880px; padding: 28px; background: #000; box-shadow: 0 0 0 4px var(--cyan); }
  .char label, .save label { display: grid; gap: 6px; font-size: 13px; color: var(--mute); text-transform: uppercase; }
  .char .wide, .char fieldset { grid-column: 1 / -1; }
  .char input:not([type=radio]):not([type=checkbox]), .char textarea, .save input[type=email] { font: 400 16px 'IBM Plex Mono', monospace; color: var(--ink); background: var(--bg); border: 0; padding: 12px; box-shadow: 0 0 0 4px #2d2566; resize: vertical; }
  .char input:focus, .char textarea:focus, .save input:focus { outline: none; box-shadow: 0 0 0 4px var(--yellow); }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 16px; flex-wrap: wrap; }
  legend { font-size: 13px; color: var(--mute); text-transform: uppercase; margin-bottom: 8px; }
  .cls { cursor: pointer; text-transform: none !important; }
  .cls input { position: absolute; opacity: 0; }
  .cls span { display: grid; gap: 2px; padding: 14px 18px; box-shadow: 0 0 0 4px #2d2566; color: var(--mute); min-width: 200px; }
  .cls b { font: 700 20px 'Tiny5', monospace; color: var(--ink); }
  .cls input:checked + span { box-shadow: 0 0 0 4px var(--pink); background: #ff3cbc1a; }
  .cls input:focus-visible + span { outline: 2px solid var(--yellow); outline-offset: 6px; }
  .consent { display: flex !important; gap: 10px; align-items: flex-start; text-transform: none !important; }
  .char .btn { justify-self: start; margin-left: 4px; }
  .bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .save .row { display: flex; gap: 16px; margin-bottom: 12px; }
  .save .row input { flex: 1; }
  .coin .btn:first-of-type { margin-left: 4px; }
  .foot { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 12px 24px; padding: 28px clamp(16px, 3vw, 40px) 96px; border-top: 4px solid var(--violet); color: var(--mute); font-size: 13px; }
  .press { margin-left: auto; color: var(--yellow); animation: blink 1.2s steps(1) infinite; }
  @media (prefers-reduced-motion: reduce) { .start, .dots, .press, .progress span { animation: none; } }
  @media (max-width: 820px) {
    .hud dl { gap: 2px 16px; }
    .hud .hi { display: none; }
    .rules ul, .bottom, .char { grid-template-columns: 1fr; }
    .press { display: none; }
  }
  @media (max-width: 480px) { .hud img { display: none; } .hud dl { margin: 0; } }
</style>
